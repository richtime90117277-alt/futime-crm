<!DOCTYPE html>
<html lang="zh-Hant">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0,maximum-scale=1.0">
<title>富時代・預約資產諮詢</title>
<style>
*{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent}
:root{
  --o:#E8692A;--ol:#FDF0E8;
  --dark:#111111;--card:#1C1C1C;--card2:#222222;
  --gold:#C9A84C;--goldhigh:#F0C060;
  --white:#FFFFFF;--grey:#AAAAAA;--dim:#555555;
  --border:#2A2A2A;
}
html,body{height:100%;font-family:-apple-system,BlinkMacSystemFont,'PingFang TC','Noto Sans TC',sans-serif;background:var(--dark);color:var(--white)}

/* ── top bar ── */
.topbar{height:3px;background:linear-gradient(90deg,var(--o),var(--gold))}
.header{background:#0D0D0D;padding:14px 20px;display:flex;align-items:center;gap:11px;border-bottom:1px solid var(--border)}
.logo-box{width:34px;height:34px;background:var(--o);border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:15px;font-weight:900;color:#fff;flex-shrink:0}
.header-text .t{font-size:14px;font-weight:700;color:#fff;letter-spacing:.3px}
.header-text .s{font-size:10px;color:var(--grey);margin-top:1px}

/* ── hero ── */
.hero{position:relative;overflow:hidden;height:200px}
.hero-img{width:100%;height:100%;object-fit:cover;object-position:center top;filter:brightness(.35) saturate(.6)}
.hero-overlay{position:absolute;inset:0;background:linear-gradient(180deg,rgba(10,10,10,.2) 0%,rgba(10,10,10,.85) 100%)}
.hero-content{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:20px;text-align:center}
.hero-badge{display:inline-block;border:1px solid var(--gold);color:var(--gold);font-size:10px;font-weight:700;padding:3px 12px;border-radius:20px;margin-bottom:10px;letter-spacing:1.5px}
.hero h1{font-size:22px;font-weight:900;line-height:1.3;margin-bottom:6px}
.hero h1 em{color:var(--o);font-style:normal}
.hero p{font-size:12px;color:var(--grey);line-height:1.6}

/* ── consultant strip ── */
.consultants{display:flex;justify-content:center;gap:0;background:#161616;border-bottom:1px solid var(--border);padding:16px 20px;gap:16px}
.c-item{display:flex;flex-direction:column;align-items:center;gap:5px}
.c-photo{width:52px;height:52px;border-radius:50%;object-fit:cover;border:2px solid var(--gold)}
.c-name{font-size:9px;color:var(--grey);letter-spacing:.5px;text-align:center}

/* ── value strip ── */
.values{display:flex;gap:0;background:#141414;border-bottom:1px solid var(--border);overflow-x:auto;-webkit-overflow-scrolling:touch;padding:12px 16px;gap:8px}
.v-pill{flex:0 0 auto;border:1px solid var(--dim);color:var(--grey);font-size:11px;padding:5px 12px;border-radius:20px;white-space:nowrap}

/* ── form ── */
.form-wrap{padding:20px}
.section-label{font-size:10px;font-weight:700;color:var(--gold);letter-spacing:2px;margin-bottom:12px;text-transform:uppercase;display:flex;align-items:center;gap:8px}
.section-label::after{content:'';flex:1;height:1px;background:var(--border)}

.form-card{background:var(--card);border:1px solid var(--border);border-radius:14px;overflow:hidden;margin-bottom:20px}
.form-field{padding:14px 16px;border-bottom:1px solid var(--border);position:relative}
.form-field:last-child{border-bottom:none}
.form-field label{display:block;font-size:10px;font-weight:700;color:var(--grey);margin-bottom:7px;letter-spacing:.8px;text-transform:uppercase}
.form-field label .req{color:var(--o)}
.form-field input,.form-field textarea{width:100%;border:none;outline:none;font-size:16px;color:#fff;background:transparent;font-family:inherit}
.form-field input::placeholder,.form-field textarea::placeholder{color:var(--dim)}
.form-field textarea{resize:none;height:72px;font-size:14px;line-height:1.6}

/* focus accent */
.form-field::after{content:'';position:absolute;bottom:0;left:0;width:0;height:2px;background:var(--o);transition:width .3s}
.form-field:focus-within::after{width:100%}
.form-field:focus-within label{color:var(--o)}

/* ── submit ── */
.submit-wrap{padding-bottom:40px}
.submit-btn{width:100%;background:var(--o);color:#fff;border:none;border-radius:14px;padding:18px;font-size:17px;font-weight:800;font-family:inherit;cursor:pointer;letter-spacing:1px;transition:all .2s;display:flex;align-items:center;justify-content:center;gap:8px;position:relative;overflow:hidden}
.submit-btn::before{content:'';position:absolute;inset:0;background:linear-gradient(135deg,rgba(255,255,255,.1),transparent);pointer-events:none}
.submit-btn:active{transform:scale(.97)}
.submit-btn:disabled{background:#333;color:#666;cursor:not-allowed;transform:none}
.disclaimer{font-size:11px;color:var(--dim);text-align:center;margin-top:12px;line-height:1.7}

/* ── success ── */
.success-view{display:none;flex-direction:column;align-items:center;padding:50px 24px 60px;text-align:center;background:var(--dark);min-height:100vh}
.success-ring{width:88px;height:88px;border-radius:50%;border:2px solid var(--gold);display:flex;align-items:center;justify-content:center;font-size:36px;margin:0 auto 24px;background:rgba(201,168,76,.08)}
.success-view h2{font-size:22px;font-weight:900;margin-bottom:8px}
.success-view h2 em{color:var(--o);font-style:normal}
.success-view p{font-size:13px;color:var(--grey);line-height:1.7;margin-bottom:24px}
.success-card{width:100%;background:var(--card);border:1px solid var(--border);border-radius:14px;overflow:hidden}
.s-row{display:flex;justify-content:space-between;padding:13px 18px;border-bottom:1px solid var(--border);font-size:13px}
.s-row:last-child{border-bottom:none}
.s-row span:first-child{color:var(--grey)}
.s-row span:last-child{color:#fff;font-weight:700}
.success-note{margin-top:20px;font-size:11px;color:var(--dim);line-height:1.7;padding:0 10px}

.spinner{width:18px;height:18px;border:2px solid rgba(255,255,255,.3);border-top-color:#fff;border-radius:50%;animation:spin .7s linear infinite;flex-shrink:0}
@keyframes spin{to{transform:rotate(360deg)}}
</style>
</head>
<body>

<div class="topbar"></div>

<div class="header">
  <div class="logo-box">富</div>
  <div class="header-text">
    <div class="t">富時代機構</div>
    <div class="s">RICH TIMES CO.,LTD</div>
  </div>
</div>

<!-- Hero with consultant photo bg -->
<div class="hero">
  <img class="hero-img" src="data:image/jpeg;base64," alt="顧問團隊">
  <div class="hero-overlay"></div>
  <div class="hero-content">
    <div class="hero-badge">現場限定・TODAY ONLY</div>
    <h1>預約<em>一對一</em><br>資產健檢諮詢</h1>
    <p>原價 $3,600｜今日現場免費<br>留下資料，顧問將主動聯繫安排</p>
  </div>
</div>

<!-- Consultant photos strip -->
<div class="consultants">
  <div class="c-item">
    <img class="c-photo" src="data:image/jpeg;base64," alt="顧問A">
    <div class="c-name">小資達人</div>
  </div>
  <div class="c-item">
    <img class="c-photo" src="data:image/jpeg;base64," alt="顧問B">
    <div class="c-name">房產新鮮人</div>
  </div>
  <div class="c-item">
    <img class="c-photo" src="data:image/jpeg;base64," alt="顧問C">
    <div class="c-name">包租女王</div>
  </div>
</div>

<!-- Value pills -->
<div class="values">
  <div class="v-pill">✦ 個人資產盤點</div>
  <div class="v-pill">✦ 策略適配分析</div>
  <div class="v-pill">✦ 行動路徑規劃</div>
  <div class="v-pill">✦ 約 45 分鐘</div>
</div>

<!-- Form -->
<div id="formView">
  <div class="form-wrap">
    <div class="section-label">填寫資料</div>
    <div class="form-card">
      <div class="form-field">
        <label>姓名 <span class="req">*</span></label>
        <input type="text" id="name" placeholder="請輸入您的姓名" autocomplete="name">
      </div>
      <div class="form-field">
        <label>手機號碼 <span class="req">*</span></label>
        <input type="tel" id="phone" placeholder="09XX-XXX-XXX" inputmode="numeric" autocomplete="tel">
      </div>
      <div class="form-field">
        <label>想了解的方向（選填）</label>
        <textarea id="note" placeholder="例如：首購規劃、包租策略、資產配置…"></textarea>
      </div>
    </div>

    <div class="submit-wrap">
      <button class="submit-btn" id="submitBtn" onclick="submitForm()">
        <span id="btnText">立即預約・免費諮詢</span>
        <span id="btnSpinner" class="spinner" style="display:none"></span>
      </button>
      <p class="disclaimer">
        提交後我們將盡快安排顧問與您聯繫<br>
        如有問題請告知現場工作人員
      </p>
    </div>
  </div>
</div>

<!-- Success -->
<div class="success-view" id="successView">
  <div class="success-ring">✓</div>
  <h2>預約<em>成功</em>！</h2>
  <p>感謝您的信任<br>我們將盡快安排專屬顧問<br>以電話與您聯繫確認時間</p>
  <div class="success-card">
    <div class="s-row"><span>姓名</span><span id="s-name">—</span></div>
    <div class="s-row"><span>電話</span><span id="s-phone">—</span></div>
    <div class="s-row"><span>備註</span><span id="s-note">—</span></div>
    <div class="s-row"><span>狀態</span><span style="color:var(--gold)">等待顧問聯繫</span></div>
  </div>
  <p class="success-note">
    顧問將於 24 小時內主動聯繫您<br>
    若有急迫需求，請直接告知現場工作人員
  </p>
</div>

<script>
const GAS_URL = "https://script.google.com/macros/s/AKfycbyoYXfbxxFUU7qaud8uBTUWsXw0z7cSEEIO1oW1PiU9QdvginvjfXGypWtG0Lzk15-C/exec";

async function submitForm() {
  const name  = document.getElementById('name').value.trim();
  const phone = document.getElementById('phone').value.trim();
  const note  = document.getElementById('note').value.trim();

  if (!name) { alert('請填寫姓名'); return; }
  if (!phone) { alert('請填寫手機號碼'); return; }
  if (!/^09\d{8}$/.test(phone.replace(/[-\s]/g,''))) {
    alert('手機號碼格式不正確\n請輸入 09 開頭共 10 碼');
    return;
  }

  const btn = document.getElementById('submitBtn');
  document.getElementById('btnText').textContent = '送出中...';
  document.getElementById('btnSpinner').style.display = 'block';
  btn.disabled = true;

  const payload = {
    action: 'addBooking',
    name, phone,
    consultant: '待安排',
    timeslot:   '待確認',
    note:       note || '—',
    source:     '研討會QRCode',
    timestamp:  new Date().toLocaleString('zh-TW', {timeZone:'Asia/Taipei'}),
  };

  try {
    // ⚠️ GAS doPost 用 JSON.parse(e.postData.contents) 解析
    // 必須送 JSON 字串，不能用 FormData
    await fetch(GAS_URL, {
      method: 'POST',
      headers: { 'Content-Type': 'text/plain;charset=utf-8' },
      body: JSON.stringify(payload),
      mode: 'no-cors'
    });

    // Show success
    document.getElementById('formView').style.display = 'none';
    const sv = document.getElementById('successView');
    sv.style.display = 'flex';
    document.getElementById('s-name').textContent  = name;
    document.getElementById('s-phone').textContent = phone;
    document.getElementById('s-note').textContent  = note || '無';
    window.scrollTo(0,0);

  } catch(e) {
    alert('提交時發生問題，請告知現場工作人員！');
    document.getElementById('btnText').textContent = '立即預約・免費諮詢';
    document.getElementById('btnSpinner').style.display = 'none';
    btn.disabled = false;
  }
}
</script>
</body>
</html>
